
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum MatchStatus {
  pending
  active
  completed
  cancelled
}

enum MatchSide {
  player1
  player2
}

enum ConsentType {
  camera
  terms
}

enum TrustLevel {
  high
  medium
  low
}

enum AntiCheatDecision {
  valid
  flagged
  discarded
}

enum Role {
  user
  moderator
}

enum ReportReason {
  cheating
  harassment
  inappropriate_camera_content
  other
}

enum ReportStatus {
  open
  resolved
}

enum ModerationActionType {
  dismissed
  warned
  banned
}

enum ReportSource {
  manual
  anti_cheat
}

model User {
  id           String    @id @default(uuid(7))
  email        String    @unique
  passwordHash String
  displayName  String
  avatarUrl    String?
  anonymizedAt DateTime?
  role         Role      @default(user)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  profile             Profile?
  refreshTokens       RefreshToken[]
  consents            Consent[]
  matchParticipations MatchParticipant[]
  matchesAsPlayer1    Match[]             @relation("MatchPlayer1")
  matchesAsPlayer2    Match[]             @relation("MatchPlayer2")
  matchesWon          Match[]             @relation("MatchWinner")
  resultsAsPlayer1    MatchResult[]       @relation("MatchResultPlayer1")
  resultsAsPlayer2    MatchResult[]       @relation("MatchResultPlayer2")
  resultsWon          MatchResult[]       @relation("MatchResultWinner")
  rankingSnapshots    RankingSnapshot[]
  antiCheatIncidents  AntiCheatIncident[]
  reportsFiled        Report[]            @relation("ReportsFiled")
  reportsReceived     Report[]            @relation("ReportsReceived")
  reportsResolved     Report[]            @relation("ReportsResolved")
  bansReceived        Ban[]               @relation("BanTarget")
  bansIssued          Ban[]               @relation("BanIssuedBy")
  bansLifted          Ban[]               @relation("BanLiftedBy")

  @@map("users")
}

model Profile {
  userId        String   @id
  nickname      String
  avatarUrl     String?
  bio           String?
  rating        Int      @default(1000)
  auraScoreAvg  Float?
  matchesPlayed Int      @default(0)
  wins          Int      @default(0)
  losses        Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([rating(sort: Desc)])
  @@map("profiles")
}

model RefreshToken {
  id        String    @id @default(uuid(7))
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Consent {
  id           String      @id @default(uuid(7))
  userId       String
  type         ConsentType
  termsVersion String
  grantedAt    DateTime    @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@map("consents")
}

model Match {
  id              String      @id @default(uuid(7))
  player1Id       String
  player2Id       String
  status          MatchStatus @default(pending)
  scoreVersion    String?
  featuresPlayer1 Json?
  featuresPlayer2 Json?
  scorePlayer1    Json?
  scorePlayer2    Json?
  winnerId        String?
  startedAt       DateTime?
  endedAt         DateTime?
  createdAt       DateTime    @default(now())

  player1            User                @relation("MatchPlayer1", fields: [player1Id], references: [id], onDelete: Restrict)
  player2            User                @relation("MatchPlayer2", fields: [player2Id], references: [id], onDelete: Restrict)
  winner             User?               @relation("MatchWinner", fields: [winnerId], references: [id], onDelete: Restrict)
  participants       MatchParticipant[]
  result             MatchResult?
  antiCheatIncidents AntiCheatIncident[]
  reports            Report[]

  @@index([player1Id])
  @@index([player2Id])
  @@index([status])
  @@map("matches")
}

model MatchParticipant {
  id           String    @id @default(uuid(7))
  matchId      String
  userId       String
  side         MatchSide
  ratingBefore Int
  ratingAfter  Int?
  createdAt    DateTime  @default(now())

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([matchId, userId])
  @@unique([matchId, side])
  @@index([userId])
  @@map("match_participants")
}

model MatchResult {
  id                 String   @id @default(uuid(7))
  matchId            String   @unique
  player1Id          String
  player1Score       Json
  player1RatingDelta Int
  player2Id          String
  player2Score       Json
  player2RatingDelta Int
  winnerId           String?
  createdAt          DateTime @default(now())

  match   Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  player1 User  @relation("MatchResultPlayer1", fields: [player1Id], references: [id], onDelete: Restrict)
  player2 User  @relation("MatchResultPlayer2", fields: [player2Id], references: [id], onDelete: Restrict)
  winner  User? @relation("MatchResultWinner", fields: [winnerId], references: [id], onDelete: Restrict)

  @@index([player1Id])
  @@index([player2Id])
  @@map("match_results")
}

model RankingSnapshot {
  id            String   @id @default(uuid(7))
  snapshotAt    DateTime @default(now())
  rank          Int
  userId        String
  displayName   String
  rating        Int
  auraScoreAvg  Float
  matchesPlayed Int

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([snapshotAt, rank])
  @@index([userId])
  @@map("ranking_snapshots")
}

model AntiCheatIncident {
  id                     String            @id @default(uuid(7))
  matchId                String
  userId                 String
  decision               AntiCheatDecision
  trustLevel             TrustLevel
  trustScore             Float
  discrepancyAvg         Float?
  rejectedPacketRatio    Float
  temporalViolationCount Int
  challengesIssued       Int
  challengesAnswered     Int
  detail                 Json
  version                String
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Restrict)
  report Report?

  @@unique([matchId, userId])
  @@index([userId])
  @@index([decision])
  @@map("anti_cheat_incidents")
}

model Report {
  id                  String                @id @default(uuid(7))
  reporterId          String?
  reportedId          String
  matchId             String?
  antiCheatIncidentId String?               @unique
  source              ReportSource          @default(manual)
  reason              ReportReason
  details             String?
  status              ReportStatus          @default(open)
  action              ModerationActionType?
  resolutionNote      String?
  resolvedById        String?
  resolvedAt          DateTime?
  banId               String?               @unique
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  reporter          User?              @relation("ReportsFiled", fields: [reporterId], references: [id], onDelete: Restrict)
  reported          User               @relation("ReportsReceived", fields: [reportedId], references: [id], onDelete: Restrict)
  match             Match?             @relation(fields: [matchId], references: [id], onDelete: Restrict)
  antiCheatIncident AntiCheatIncident? @relation(fields: [antiCheatIncidentId], references: [id], onDelete: Restrict)
  resolvedBy        User?              @relation("ReportsResolved", fields: [resolvedById], references: [id], onDelete: Restrict)
  ban               Ban?               @relation(fields: [banId], references: [id], onDelete: Restrict)

  @@index([reportedId])
  @@index([status])
  @@index([matchId])
  @@map("reports")
}

model Ban {
  id         String    @id @default(uuid(7))
  userId     String
  issuedById String
  reason     String
  expiresAt  DateTime?
  liftedAt   DateTime?
  liftedById String?
  createdAt  DateTime  @default(now())

  user     User    @relation("BanTarget", fields: [userId], references: [id], onDelete: Restrict)
  issuedBy User    @relation("BanIssuedBy", fields: [issuedById], references: [id], onDelete: Restrict)
  liftedBy User?   @relation("BanLiftedBy", fields: [liftedById], references: [id], onDelete: Restrict)
  report   Report?

  @@index([userId])
  @@map("bans")
}
