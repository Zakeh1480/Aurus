# Este .env fica na RAIZ do monorepo — apps/api (prisma.config.ts, main.ts,
# prisma/seed.ts) carrega este arquivo explicitamente mesmo rodando com cwd
# em apps/api. Algumas variáveis abaixo só passam a ser lidas em prompts
# futuros (auth, vídeo).

# apps/web
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=ws://localhost:3001

# apps/api — DATABASE_URL deve bater com as credenciais do docker-compose.yml
PORT=3001
DATABASE_URL=postgresql://aurafarming:aurafarming@localhost:5432/aurafarming
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
WEB_ORIGIN=http://localhost:3000

# apps/api — matchmaking (Prompt 4)
MATCH_RATING_WINDOW_BASE=50
MATCH_RATING_WINDOW_STEP=25
MATCH_RATING_WINDOW_STEP_MS=5000
MATCH_RATING_WINDOW_MAX=400
MATCH_ACCEPT_TIMEOUT_MS=10000
MATCH_GUARD_TTL_MS=21600000

# LiveKit (vídeo) — Prompt 5: emissão de tokens + webhook de fim de partida
# Configure no painel do LiveKit Cloud um webhook apontando para
# POST {API_URL}/livekit/webhook (em dev local, exige um túnel tipo ngrok).
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=wss://your-livekit-instance
# TTL do access token emitido em POST /matches/:id/token — opcional, default 7200 (2h)
LIVEKIT_TOKEN_TTL_SECONDS=7200

# services/ai
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_PORT=8000

# apps/api — anti-cheat (Prompt 6b)
ANTI_CHEAT_SESSION_SECRET_TTL_SECONDS=10800
ANTI_CHEAT_CHALLENGE_TTL_MS=30000
ANTI_CHEAT_CHALLENGES_MIN=2
ANTI_CHEAT_CHALLENGES_MAX=4
ANTI_CHEAT_CHALLENGE_INTERVAL_MIN_MS=60000
ANTI_CHEAT_CHALLENGE_INTERVAL_MAX_MS=180000
ANTI_CHEAT_MAX_SESSION_MS=1800000
ANTI_CHEAT_FEATURE_NONCE_WINDOW_MS=10000
ANTI_CHEAT_FEATURE_CLOCK_SKEW_MS=5000
ANTI_CHEAT_MAX_METRIC_DELTA_PER_SECOND=2.0
ANTI_CHEAT_TEMPORAL_VIOLATION_SATURATION=5
ANTI_CHEAT_STATS_TTL_SECONDS=3600
ANTI_CHEAT_TRUST_HIGH_MIN=0.75
ANTI_CHEAT_TRUST_LOW_MAX=0.4
ANTI_CHEAT_TRUST_WEIGHT_DISCREPANCY=0.35
ANTI_CHEAT_TRUST_WEIGHT_LIVENESS=0.30
ANTI_CHEAT_TRUST_WEIGHT_REJECTED=0.20
ANTI_CHEAT_TRUST_WEIGHT_TEMPORAL=0.10
ANTI_CHEAT_TRUST_WEIGHT_COVERAGE=0.05
ANTI_CHEAT_AI_VERIFY_TIMEOUT_MS=3000

# services/ai — /verify (Prompt 6b)
ANTI_CHEAT_BLUR_VARIANCE_STATIC_THRESHOLD=15.0
ANTI_CHEAT_BLUR_VARIANCE_LOW_DETAIL_THRESHOLD=60.0
ANTI_CHEAT_FACE_MIN_AREA_RATIO=0.05
