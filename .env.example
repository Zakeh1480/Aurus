# A maioria destas variáveis só passa a ser lida em prompts futuros
# (auth, matchmaking, vídeo). Nenhuma delas é obrigatória para
# `pnpm install && pnpm build` no estado atual do repo.

# apps/web
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=ws://localhost:3001

# apps/api
PORT=3001
DATABASE_URL=postgresql://user:password@localhost:5432/aurafarming
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me

# LiveKit (vídeo) — usado a partir do prompt que liga as partidas
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=wss://your-livekit-instance

# services/ai
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_PORT=8000
