# Este .env fica na RAIZ do monorepo — apps/api (prisma.config.ts, main.ts,
# prisma/seed.ts) carrega este arquivo explicitamente mesmo rodando com cwd
# em apps/api. Algumas variáveis abaixo só passam a ser lidas em prompts
# futuros (auth, vídeo).

# apps/web — o browser só fala com o próprio Next.js (BFF); NEXT_PUBLIC_WS_URL
# continua público porque o WebSocket conecta direto do browser em apps/api
# (não dá pra proxyar uma conexão WS de longa duração por Route Handlers
# serverless). API_INTERNAL_URL é server-only — usado só pelos Route Handlers
# do BFF (apps/web/src/app/api/bff/**) para falar com apps/api.
NEXT_PUBLIC_WS_URL=ws://localhost:3001
API_INTERNAL_URL=http://localhost:3001
# Chave usada pelo iron-session para selar o cookie de sessão do BFF
# (apps/web/src/lib/bff/session.ts) — precisa ter pelo menos 32 caracteres,
# nunca "change-me" sozinho, em qualquer ambiente deployado.
BFF_SESSION_SECRET=change-me-to-a-random-string-of-at-least-32-chars
# Override explícito da flag `secure` do cookie de sessão do BFF, mesmo
# padrão de COOKIE_SECURE (abaixo). Deixe vazio/ausente para usar o default
# (secure só quando NODE_ENV=production).
BFF_SESSION_COOKIE_SECURE=
# apps/web (BFF) <-> apps/api — segredo compartilhado enviado em todo
# fetch dos Route Handlers do BFF (header X-BFF-Secret), exigido por
# apps/api em qualquer rota que não seja /health ou /livekit/webhook
# (apps/api/src/common/bff-secret.middleware.ts). Trocar por um valor real
# (nunca "change-me") em qualquer ambiente deployado — precisa bater com o
# mesmo valor em apps/api.
BFF_SHARED_SECRET=change-me

# apps/api — DATABASE_URL deve bater com as credenciais do docker-compose.yml
PORT=3001
DATABASE_URL=postgresql://aurafarming:aurafarming@localhost:5432/aurafarming
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
# Janela de graça (ms) em que uma corrida de refresh concorrente (comum
# agora que o BFF pode disparar múltiplas invocações serverless em paralelo
# perto da expiração do access token) é tratada como rotação benigna em vez
# de reuso de token — opcional, default 5000.
JWT_REFRESH_CONCURRENT_GRACE_MS=5000
WEB_ORIGIN=http://localhost:3000
# Override explícito da flag `secure` do cookie de refresh (Prompt 32) —
# "true"/"false" vence sobre o default (secure só quando NODE_ENV=production).
# Útil se algum ambiente exposto (ex.: staging atrás de HTTPS) não seta
# NODE_ENV=production. Deixe vazio/ausente para usar o default.
COOKIE_SECURE=

# apps/api — matchmaking (Prompt 4)
MATCH_RATING_WINDOW_BASE=50
MATCH_RATING_WINDOW_STEP=25
MATCH_RATING_WINDOW_STEP_MS=5000
MATCH_RATING_WINDOW_MAX=400
MATCH_ACCEPT_TIMEOUT_MS=10000
MATCH_GUARD_TTL_MS=21600000
MATCH_ACCEPT_POLL_INTERVAL_MS=1000
# TTL (segundos) do ticket de uso único emitido por POST /ws/ticket — trocado
# pelo browser no handshake do socket.io em vez de um JWT (o BFF pede o
# ticket server-to-server, o browser nunca vê o access token) — opcional,
# default 30.
WS_TICKET_TTL_SECONDS=30

# LiveKit (vídeo) — Prompt 5: emissão de tokens + webhook de fim de partida
# Configure no painel do LiveKit Cloud um webhook apontando para
# POST {API_URL}/livekit/webhook (em dev local, exige um túnel tipo ngrok).
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=wss://your-livekit-instance
# TTL do access token emitido em POST /matches/:id/token — opcional, default 7200 (2h)
LIVEKIT_TOKEN_TTL_SECONDS=7200
# Cadência do poller cross-instance que encerra partidas por tempo esgotado — opcional, default 1000ms
MATCH_DURATION_POLL_INTERVAL_MS=1000

# services/ai
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_PORT=8000
# Rate limit por IP (Prompt 28, defesa em profundidade além do segredo
# compartilhado) — opcional, defaults generosos acima do volume legítimo
# esperado (ver app/rate_limit.py).
AI_SERVICE_RATE_LIMIT_MAX_REQUESTS=1200
AI_SERVICE_RATE_LIMIT_WINDOW_SECONDS=60

# apps/api — anti-cheat (Prompt 6b)
ANTI_CHEAT_SESSION_SECRET_TTL_SECONDS=10800
ANTI_CHEAT_CHALLENGE_TTL_MS=30000
ANTI_CHEAT_CHALLENGES_MIN=2
ANTI_CHEAT_CHALLENGES_MAX=4
ANTI_CHEAT_CHALLENGE_INTERVAL_MIN_MS=60000
ANTI_CHEAT_CHALLENGE_INTERVAL_MAX_MS=180000
# Cadência do poller cross-instance que processa desafios de anti-cheat vencidos — opcional, default 1000ms
ANTI_CHEAT_CHALLENGE_POLL_INTERVAL_MS=1000
ANTI_CHEAT_MAX_SESSION_MS=1800000
ANTI_CHEAT_FEATURE_NONCE_WINDOW_MS=10000
ANTI_CHEAT_FEATURE_CLOCK_SKEW_MS=5000
ANTI_CHEAT_MAX_METRIC_DELTA_PER_SECOND=2.0
ANTI_CHEAT_TEMPORAL_VIOLATION_SATURATION=5
ANTI_CHEAT_STATS_TTL_SECONDS=3600
ANTI_CHEAT_TRUST_HIGH_MIN=0.75
ANTI_CHEAT_TRUST_LOW_MAX=0.4
ANTI_CHEAT_TRUST_WEIGHT_DISCREPANCY=0.35
ANTI_CHEAT_TRUST_WEIGHT_LIVENESS=0.30
ANTI_CHEAT_TRUST_WEIGHT_REJECTED=0.20
ANTI_CHEAT_TRUST_WEIGHT_TEMPORAL=0.10
ANTI_CHEAT_TRUST_WEIGHT_COVERAGE=0.05
ANTI_CHEAT_AI_VERIFY_TIMEOUT_MS=3000

# services/ai — /verify (Prompt 6b)
ANTI_CHEAT_BLUR_VARIANCE_STATIC_THRESHOLD=15.0
ANTI_CHEAT_BLUR_VARIANCE_LOW_DETAIL_THRESHOLD=60.0
ANTI_CHEAT_FACE_MIN_AREA_RATIO=0.05

# apps/api — scoring/ranking (Prompt 7)
MATCH_SCORE_AI_TIMEOUT_MS=3000
MATCH_SCORE_TICK_INTERVAL_MS=5000
# Cadência do poller cross-instance que processa ticks de score vencidos — opcional, default 1000ms
MATCH_SCORE_TICK_POLL_INTERVAL_MS=1000
MATCH_SCORE_SAMPLE_BUFFER_MAX_LENGTH=2000
MATCH_SCORE_SAMPLE_BUFFER_TTL_SECONDS=3600
MATCH_ELO_K_FACTOR=32

# apps/api <-> services/ai — segredo compartilhado (Prompt 13, hardening)
# Enviado no header x-ai-service-secret em toda chamada a /score,
# /score/aggregate e /verify — troque por um valor real (nunca "change-me")
# em qualquer ambiente deployado, não só produção.
AI_SERVICE_SHARED_SECRET=change-me

# Rotação com chave(s) anterior(es) (Prompt 18, opcional, só em services/ai;
# lista desde o Prompt 23). Ao trocar o segredo acima, setar temporariamente
# o(s) valor(es) ANTIGO(s) em AI_SERVICE_SHARED_SECRET_PREVIOUS no ambiente
# de services/ai — permite fazer o deploy de services/ai antes de apps/api
# sem quebrar scoring/verify no meio do rollout. Aceita uma lista separada
# por vírgula (ex.: "old1,old2"), permitindo trocar de novo antes de remover
# a anterior (rotação encadeada). Remover depois que apps/api também estiver
# atualizado.
# AI_SERVICE_SHARED_SECRET_PREVIOUS=

# apps/api — moderação (Prompt 13, hardening)
# Lista de e-mails (separados por vírgula) promovidos a role=moderator na
# subida da API — único mecanismo de bootstrap do MVP, sem UI de promoção.
MODERATION_BOOTSTRAP_EMAILS=

# apps/api — upload de avatar (Prompt 29)
# Storage de objetos S3-compatible (Cloudflare R2, S3, MinIO etc.) — trilha
# humana, mesmo padrão de LIVEKIT_*: troque por credenciais reais em
# qualquer ambiente deployado. Sem essas variáveis configuradas, o upload
# falha (fail-closed) só quando de fato chamado — não trava o boot da API.
AVATAR_STORAGE_ENDPOINT=
AVATAR_STORAGE_REGION=auto
AVATAR_STORAGE_BUCKET=
AVATAR_STORAGE_ACCESS_KEY_ID=
AVATAR_STORAGE_SECRET_ACCESS_KEY=
# URL pública de leitura do bucket/CDN na frente dele — usada para montar o
# avatarUrl final e também referenciada por apps/web (NEXT_PUBLIC_AVATAR_PUBLIC_BASE_URL)
# na allowlist de img-src do CSP.
AVATAR_STORAGE_PUBLIC_BASE_URL=
