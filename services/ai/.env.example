# Railway injeta estas variáveis via dashboard/CLI. Em dev local, use o
# .env da RAIZ do monorepo — este arquivo só documenta o subconjunto que
# services/ai lê.

AI_SERVICE_PORT=8000

# apps/api <-> services/ai — segredo compartilhado (Prompt 13, hardening).
# Precisa ser IDÊNTICO ao AI_SERVICE_SHARED_SECRET de apps/api (ver
# docs/security-checklist.md) — trocar o "change-me" em qualquer ambiente
# deployado.
AI_SERVICE_SHARED_SECRET=change-me

# Rotação com chave(s) anterior(es) (Prompt 18, opcional; lista desde o
# Prompt 23). Durante a troca do segredo, setar aqui o(s) valor(es) ANTIGO(s)
# antes de trocar AI_SERVICE_SHARED_SECRET acima pelo novo — services/ai
# aceita qualquer um deles até o deploy de apps/api também alcançar o novo
# valor. Aceita uma lista separada por vírgula (ex.: "old1,old2"), o que
# viabiliza rotação encadeada (trocar de novo antes de remover a anterior).
# Remover num deploy seguinte, quando não precisar mais aceitar valores antigos.
# AI_SERVICE_SHARED_SECRET_PREVIOUS=

# anti-cheat /verify (Prompt 6b)
ANTI_CHEAT_BLUR_VARIANCE_STATIC_THRESHOLD=15.0
ANTI_CHEAT_BLUR_VARIANCE_LOW_DETAIL_THRESHOLD=60.0
ANTI_CHEAT_FACE_MIN_AREA_RATIO=0.05
