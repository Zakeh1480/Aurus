  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -c \"import sys,json; d=json.load(sys.stdin); print(d.get('tool_input',{}).get('file_path','') or '')\" | { read -r f; case \"$f\" in *.ts|*.tsx|*.js|*.jsx|*.json|*.md|*.css) (cd /home/isaque/Documentos/projetos/aurus && pnpm exec prettier --write \"$f\") ;; esac; } 2>/dev/null || true",
            "timeout": 30,
            "statusMessage": "Formatando com Prettier..."
          }
        ]
      }
    ]
  }
